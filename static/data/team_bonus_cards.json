    "  type:        value | progression | dual | multi | desc | hidden",
    "  heading:     Big bold text — '+20%', 'FREE', 'CAN', etc.",
    "  stat:        Smaller label below heading",
    "  description: Bottom label (who/what is affected)",
    "  entity:      Unit/building key — drives icon",
    "  entity2:     Second entity for 'dual' cards",
    "  lines:       ['...','...'] — desc card lines",
    "  multiplier:  false → hide multiplier control (unlock/binary bonuses)",
